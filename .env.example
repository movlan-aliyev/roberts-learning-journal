# GitHub Pages base path (set to /repo-name for project sites)
NEXT_PUBLIC_BASE_PATH=

# Supabase (optional — app runs in local demo mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Content generation provider (optional — local authored content works without)
CONTENT_PROVIDER_API_KEY=
CONTENT_PROVIDER_BASE_URL=

# Owner timezone (default: America/New_York)
NEXT_PUBLIC_OWNER_TIMEZONE=America/New_York

# Owner PIN for Write / Study / Settings (visible in client bundle — change before public deploy)
NEXT_PUBLIC_OWNER_PIN=robert-learn
